{
  "config": {
    "step": {
      "user": {
        "title": "Connect Kaadas account",
        "description": "Enter the token (request header) and uid (findAllBindDevice body) captured from the Kaadas app.",
        "data": {
          "token": "Token",
          "uid": "uid",
          "user_agent": "User-Agent",
          "phone_name": "Phone name"
        }
      },
      "device": {
        "title": "Choose lock",
        "data": {
          "wifi_sn": "Lock"
        }
      },
      "reauth_confirm": {
        "title": "Token expired",
        "description": "Capture a new token from the Kaadas app. If you switch to another account (e.g. one dedicated to Home Assistant), also enter that account's uid.",
        "data": {
          "token": "Token",
          "uid": "uid"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid or expired token",
      "cannot_connect": "Cannot connect to Kaadas cloud",
      "no_devices": "No Wi-Fi lock on this account",
      "device_not_found": "The lock is not on this account"
    },
    "abort": {
      "already_configured": "Lock already configured",
      "reauth_successful": "Token updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "data": {
          "scan_interval": "Record poll interval (s)",
          "info_interval": "Device info interval (s)",
          "image_rotation": "Snapshot rotation (clockwise)",
          "push": "Real-time push (MQTT)"
        },
        "description": "Real-time push uses the same client ID as the phone app: if Home Assistant and the phone use the same account, they will kick each other offline. Share the lock to a dedicated account for Home Assistant."
      }
    }
  },
  "entity": {
    "camera": {
      "snapshot": {
        "name": "Door snapshot"
      }
    },
    "event": {
      "doorbell": {
        "name": "Doorbell",
        "state_attributes": {
          "event_type": {
            "state": {
              "ring": "Ring"
            }
          }
        }
      },
      "loitering": {
        "name": "Loitering",
        "state_attributes": {
          "event_type": {
            "state": {
              "loitering": "Loitering"
            }
          }
        }
      },
      "lock_activity": {
        "name": "Lock activity",
        "state_attributes": {
          "event_type": {
            "state": {
              "unlocked": "Unlocked",
              "locked": "Locked"
            }
          }
        }
      },
      "alarm": {
        "name": "Lock alarm",
        "state_attributes": {
          "event_type": {
            "state": {
              "bolt_jammed": "Bolt jammed",
              "alarm": "Other alarm"
            }
          }
        }
      }
